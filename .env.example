# Database
POSTGRES_USER=schedule
POSTGRES_PASSWORD=schedule_dev_password
POSTGRES_DB=university_schedule
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://schedule:schedule_dev_password@localhost:5432/university_schedule

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
ADMIN_JWT_EXPIRE_MINUTES=480
ENVIRONMENT=development
DEBUG=true
RATE_LIMIT_PER_MINUTE=120

# Default admin (seeded on first run / seed script)
ADMIN_EMAIL=admin@university.local
ADMIN_PASSWORD=Admin123!ChangeMe
ADMIN_FULL_NAME=System Administrator

# Telegram
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
MINI_APP_URL=http://localhost:3000
# Set true only for local UI testing without Telegram signature
TELEGRAM_AUTH_BYPASS=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
